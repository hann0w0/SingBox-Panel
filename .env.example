# Public HTTPS origin, without a path. The proxy must support WebSocket.
PANEL_BASE_URL=https://panel.example.com
PANEL_ADMIN=admin@example.com
# Required on the first start; a long, unique password is recommended (max 72 bytes).
# Single quotes preserve literal $ and # characters in Compose .env files.
# After the first successful login, clear this value and recreate the container.
PANEL_ADMIN_PASSWORD=''

# Prebuilt image; no source checkout or local build is needed.
# Release downloads pin this value to that release's actual repository/tag.
# :latest is published after checked main builds and stable releases.
# :edge remains an alias for checked main builds; pin a version tag if needed.
PANEL_IMAGE=ghcr.io/hann0w0/singbox-panel:latest

# Optional: comma-separated IPs/CIDRs of the reverse proxy allowed to set
# X-Real-IP. Empty trusts any loopback/private peer (the previous behaviour).
PANEL_TRUSTED_PROXIES=

# The default bind is only reachable from the host's reverse proxy.
PANEL_BIND=127.0.0.1
PANEL_PORT=32334
