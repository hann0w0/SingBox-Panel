# Host port for the local reverse proxy. Docker always binds it to 127.0.0.1.
PANEL_PORT=32334

# Only used to create the first administrator on an empty database.
ADMIN=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Required HTTPS domain used by the panel, subscriptions and Agents.
WEB=https://panel.example.com

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Published image used by install.sh and optional Docker Compose deployment.
SINGPANEL_IMAGE=hann0w0/singbox-panel
SINGPANEL_TAG=latest
